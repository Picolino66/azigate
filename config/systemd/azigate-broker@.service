[Unit]
Description=AziGate CLI broker para %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
Group=%i
WorkingDirectory=/opt/azigate
Environment=BROKER_SOCKET_PATH=/run/azigate/broker.sock
Environment=BROKER_EXECUTION_LOG_DIR=/run/azigate/logs
Environment=BROKER_ENABLE_CODEX_CLI=true
Environment=BROKER_ENABLE_CLAUDE_CLI=false
Environment=BROKER_CODEX_SESSION_MODE=memory
Environment=BROKER_CLAUDE_SESSION_MODE=memory
Environment=BROKER_MAX_ACTIVE_SESSIONS=4
Environment=BROKER_SESSION_IDLE_MS=1800000
Environment=BROKER_MAX_TRANSCRIPT_BYTES=262144
EnvironmentFile=-/etc/azigate/broker.env
ExecStart=/usr/bin/node /opt/azigate/dist/broker/server.js
Restart=on-failure
RestartSec=5s
UMask=0077
RuntimeDirectory=azigate
RuntimeDirectoryMode=0700

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindPaths=-/home/%i/.codex -/home/%i/.claude
BindReadOnlyPaths=-/home/%i/.claude.json -/home/%i/.local/bin/claude -/home/%i/.local/share/claude
ReadWritePaths=/run/azigate
ProtectKernelModules=yes
# ProtectKernelTunables, ProtectKernelLogs e ProtectHostname conflitam com
# namespaces aninhados do Bubblewrap em Ubuntu/AppArmor.
# O serviço permanece sem capabilities e executado como usuário não root.
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
TasksMax=64
MemoryMax=1G
KillMode=control-group
TimeoutStopSec=15s

[Install]
WantedBy=multi-user.target
