{
  "name": "azigate",
  "version": "1.0.0",
  "private": true,
  "description": "Gateway OpenAI Compatible (Model Plane) e Agent Plane nativo para Codex, Claude Code e Antigravity",
  "type": "module",
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "dev:agentd": "tsx watch --env-file=.env src/agentd/server.ts",
    "start": "node dist/server.js",
    "start:agentd": "node dist/agentd/server.js",
    "start:worker": "node dist/worker/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "login:codex": "tsx src/providers/oauth/login-codex.ts",
    "login:claude": "tsx src/providers/oauth/login-claude.ts",
    "experiment:previous-response": "tsx test/manual/previous-response-id-scenarios.ts",
    "worker:token": "tsx src/agentd/worker-token.ts",
    "test:agents:real": "tsx test/manual/agents-real.ts"
  },
  "dependencies": {
    "@fastify/websocket": "11.3.1",
    "dotenv": "17.4.2",
    "fastify": "5.10.0",
    "pino": "10.3.1",
    "undici": "7.28.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.4",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.7.0",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10"
  }
}
