{
  "name": "azigate",
  "version": "1.0.0",
  "private": true,
  "description": "Gateway OpenAI Compatible seguro para DeepSeek e CLIs locais isoladas",
  "type": "module",
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "broker:dev": "tsx watch src/broker/server.ts",
    "broker:start": "node dist/broker/server.js",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "gate:codex": "tsx src/broker/viability-gate.ts codex",
    "gate:claude": "tsx src/broker/viability-gate.ts claude",
    "gate:claude-efforts": "tsx src/broker/viability-gate.ts claude-efforts"
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "fastify": "5.10.0",
    "pino": "10.3.1",
    "undici": "7.28.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "20.19.43",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.7.0",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
