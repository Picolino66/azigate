NODE_ENV=production
PORT=3000
HOST=0.0.0.0
# Use o IP privado do servidor para acesso pela rede local.
# Mantenha 127.0.0.1 quando houver Nginx na mesma máquina.
GATEWAY_BIND_ADDRESS=127.0.0.1

# Upstream OpenAI-compatible (nomes históricos DEEPSEEK_*). Apontam para QUALQUER
# provedor OpenAI-compatible, não só a DeepSeek. A base deve ser a raiz da API sobre
# a qual o gateway anexa "models" e "chat/completions" (normalmente termina em /v1).
# Exemplos: https://api.deepseek.com | https://api.openai.com/v1
#           https://openrouter.ai/api/v1 | https://api.groq.com/openai/v1
# Em produção a base precisa ser HTTPS; http:// (Ollama/LM Studio/vLLM) só em dev.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_API_KEY_FILE=

GATEWAY_API_KEYS=
GATEWAY_API_KEYS_FILE=
# Se preenchida, inclua os aliases Codex desejados: codex-cli-sol, codex-cli-terra,
# codex-cli-luna, codex-cli-5.5, codex-cli-5.4, o legado codex-cli e apenas os
# aliases claude-cli-* aprovados nos gates reais; claude-cli equivale a Sonnet 4.6.
ALLOWED_MODELS=
DEFAULT_MODEL=
ALLOWED_IPS=

REQUEST_TIMEOUT_MS=600000
CONNECT_TIMEOUT_MS=30000
MAX_REQUEST_BODY_BYTES=10485760

RATE_LIMIT_MAX=60
RATE_LIMIT_IP_MAX=60
RATE_LIMIT_WINDOW_MS=60000

MODELS_CACHE_TTL_SECONDS=300
READY_CHECK_UPSTREAM=false
UPSTREAM_MAX_RETRIES=0
RETRY_MAX_DELAY_MS=2000

# Aliases CLI são fail-closed. Habilite somente após configurar a credencial OAuth
# do provedor (veja CODEX_TOKEN_FILE/CLAUDE_TOKEN_FILE abaixo). Codex e Claude aceitam
# reasoning_effort ou reasoning.effort com low, medium, high, xhigh ou max. Codex usa
# medium por padrão e reduz max para xhigh; Claude aplica a matriz e o default do
# modelo. Sonnet 4.5 e Haiku 4.5 nunca recebem --effort.
ENABLE_CODEX_CLI=false
ENABLE_CLAUDE_CLI=false

# Adaptador HTTP nativo do Codex (Responses API via ChatGPT backend). A credencial NÃO
# é uma API key: é um token OAuth da assinatura, obtido com
# `npm run login:codex -- secrets/codex-oauth.json` (fluxo local, abre uma URL para
# você autenticar no navegador). O gateway renova o token sozinho quando expira.
CODEX_BASE_URL=https://chatgpt.com/backend-api/codex
CODEX_TOKEN_FILE=secrets/codex-oauth.json

# Adaptador HTTP nativo do Claude (Messages API da Anthropic). Mesma lógica: token OAuth
# da assinatura, obtido com `npm run login:claude -- secrets/claude-oauth.json`. Risco
# aceito e documentado em ADR-018: sem técnicas de "cloaking"/fingerprint, a Anthropic
# pode detectar e limitar esse acesso como cliente não-oficial.
CLAUDE_BASE_URL=https://api.anthropic.com
CLAUDE_TOKEN_FILE=secrets/claude-oauth.json

LOG_LEVEL=info
TRUST_PROXY=true

MEMORY_LIMIT=512m
CPU_LIMIT=1.0

# ---------------------------------------------------------------------------
# Agent Plane (azigate-agentd) — serviço SEPARADO, roda no host (não no container)
# e usa o login oficial de cada CLI. Ver docs/operations/agent-plane.md e ADR-022.
# Só é lido por `npm run start:agentd`; o gateway de modelos ignora estas variáveis.
# ---------------------------------------------------------------------------
AGENT_GATEWAY_ENABLED=false
AGENT_HOST=127.0.0.1
AGENT_PORT=3100
# Credenciais próprias (>= 16 caracteres). NUNCA reutilize GATEWAY_API_KEYS.
AGENT_API_KEYS=
AGENT_API_KEYS_FILE=
AGENT_ALLOWED_IPS=
# true quando o Nginx estiver na frente (senão a allowlist vê 127.0.0.1).
AGENT_TRUST_PROXY=false
AGENT_RATE_LIMIT_MAX=120
AGENT_RATE_LIMIT_IP_MAX=120
AGENT_RATE_LIMIT_WINDOW_MS=60000
AGENT_MAX_REQUEST_BODY_BYTES=1048576

# Banco SQLite de metadados, socket MCP e diretórios de sessão (0700).
AGENT_DATA_DIR=data/agentd
# JSON {"workspaces": {"backend": {"path": "/home/user/projetos/backend"}}}
AGENT_WORKSPACES_FILE=

# Providers nativos. A autenticação é da própria CLI (codex login, claude, agy):
# nunca coloque tokens OAuth dos fornecedores aqui.
CODEX_AGENT_ENABLED=false
CLAUDE_AGENT_ENABLED=false
AGY_AGENT_ENABLED=false
CODEX_BINARY=codex
CLAUDE_BINARY=claude
AGY_BINARY=agy
# warn ou fail-closed (padrão em produção): CLI fora da matriz certificada.
AGENT_VERSION_POLICY=

AGENT_MAX_SESSIONS=10
AGENT_MAX_SESSIONS_PER_PROVIDER=4
AGENT_SESSION_IDLE_TIMEOUT=30m
AGENT_TURN_TIMEOUT=60m
AGENT_APPROVAL_TIMEOUT=10m
AGENT_EVENT_BUFFER=2000
AGENT_EVENT_BUFFER_BYTES=16777216
AGENT_MAX_INPUT_CHARS=100000

# Workers remotos (máquina do projeto). Segredo >= 32 caracteres, distinto das chaves.
# Gere tokens com: npm run worker:token -- --worker devbox --workspace backend --days 90
WORKER_ENABLED=false
WORKER_TOKEN_SECRET=
WORKER_TOKEN_SECRET_FILE=
WORKER_HEARTBEAT_INTERVAL=15s
AGENT_MCP_SOCKET=
