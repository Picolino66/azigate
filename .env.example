NODE_ENV=production
PORT=3000
HOST=0.0.0.0
# Use o IP privado do servidor para acesso pela rede local.
# Mantenha 127.0.0.1 quando houver Nginx na mesma máquina.
GATEWAY_BIND_ADDRESS=127.0.0.1

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_API_KEY_FILE=

GATEWAY_API_KEYS=
GATEWAY_API_KEYS_FILE=
ALLOWED_MODELS=
DEFAULT_MODEL=
ALLOWED_IPS=

REQUEST_TIMEOUT_MS=600000
CONNECT_TIMEOUT_MS=30000
MAX_REQUEST_BODY_BYTES=10485760

RATE_LIMIT_MAX=60
RATE_LIMIT_IP_MAX=60
RATE_LIMIT_WINDOW_MS=60000

MODELS_CACHE_TTL_SECONDS=300
READY_CHECK_UPSTREAM=false
UPSTREAM_MAX_RETRIES=0
RETRY_MAX_DELAY_MS=2000

LOG_LEVEL=info
TRUST_PROXY=true

MEMORY_LIMIT=512m
CPU_LIMIT=1.0
