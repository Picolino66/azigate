NODE_ENV=production
PORT=3000
HOST=0.0.0.0
# Use o IP privado do servidor para acesso pela rede local.
# Mantenha 127.0.0.1 quando houver Nginx na mesma máquina.
GATEWAY_BIND_ADDRESS=127.0.0.1

# Upstream OpenAI-compatible (nomes históricos DEEPSEEK_*). Apontam para QUALQUER
# provedor OpenAI-compatible, não só a DeepSeek. A base deve ser a raiz da API sobre
# a qual o gateway anexa "models" e "chat/completions" (normalmente termina em /v1).
# Exemplos: https://api.deepseek.com | https://api.openai.com/v1
#           https://openrouter.ai/api/v1 | https://api.groq.com/openai/v1
# Em produção a base precisa ser HTTPS; http:// (Ollama/LM Studio/vLLM) só em dev.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_API_KEY_FILE=

GATEWAY_API_KEYS=
GATEWAY_API_KEYS_FILE=
# Se preenchida, inclua os aliases Codex desejados: codex-cli-sol, codex-cli-terra,
# codex-cli-luna, codex-cli-5.5, codex-cli-5.4, o legado codex-cli e apenas os
# aliases claude-cli-* aprovados nos gates reais; claude-cli equivale a Sonnet 4.6.
ALLOWED_MODELS=
DEFAULT_MODEL=
ALLOWED_IPS=

REQUEST_TIMEOUT_MS=600000
CONNECT_TIMEOUT_MS=30000
MAX_REQUEST_BODY_BYTES=10485760

RATE_LIMIT_MAX=60
RATE_LIMIT_IP_MAX=60
RATE_LIMIT_WINDOW_MS=60000

MODELS_CACHE_TTL_SECONDS=300
READY_CHECK_UPSTREAM=false
UPSTREAM_MAX_RETRIES=0
RETRY_MAX_DELAY_MS=2000

# Aliases CLI são fail-closed. Habilite somente após o broker e o gate de viabilidade.
# Codex e Claude aceitam reasoning_effort ou reasoning.effort com low, medium, high,
# xhigh ou max. Codex usa medium por padrão e reduz max para xhigh; Claude aplica
# a matriz e o default do modelo. Sonnet 4.5 e Haiku 4.5 nunca recebem --effort.
ENABLE_CODEX_CLI=false
ENABLE_CLAUDE_CLI=false
CLI_BROKER_SOCKET_PATH=/run/gateway-ai/broker.sock
CLI_REQUEST_TIMEOUT_MS=600000
CLI_HEARTBEAT_INTERVAL_MS=15000

# O processo do container precisa usar o mesmo UID/GID do usuário do broker.
BROKER_RUNTIME_DIR=/run/gateway-ai
BROKER_UID=1000
BROKER_GID=1000

# Configuração exclusiva da unidade host gateway-ai-broker@.service.
BROKER_SOCKET_PATH=/run/gateway-ai/broker.sock
BROKER_WORK_ROOT=/tmp/gateway-ai-broker
BROKER_ENABLE_CODEX_CLI=true
BROKER_ENABLE_CLAUDE_CLI=false
BROKER_EXECUTION_TIMEOUT_MS=600000
BROKER_KILL_GRACE_MS=2000
BROKER_MAX_OUTPUT_BYTES=4194304
BROKER_MAX_REQUEST_BYTES=10485760
BWRAP_PATH=/usr/bin/bwrap
CODEX_CLI_PATH=/usr/bin/codex
CLAUDE_CLI_PATH=/home/USUARIO/.local/bin/claude
CODEX_AUTH_DIR=/home/USUARIO/.codex
CLAUDE_AUTH_DIR=/home/USUARIO/.claude
CLAUDE_CONFIG_PATH=/home/USUARIO/.claude.json

LOG_LEVEL=info
TRUST_PROXY=true

MEMORY_LIMIT=512m
CPU_LIMIT=1.0
